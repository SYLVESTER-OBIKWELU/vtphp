APP_NAME=VtPhp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Client app that hosts /reset-password; emailed reset links point here.
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC

# CORS policy (see config/cors.php). Origins are comma-separated, e.g.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://*.example.com
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# Load balancers/proxies allowed to set X-Forwarded-For/-Proto (IPs or CIDRs).
TRUSTED_PROXIES=

# Requests per minute (see config/rate_limiting.php). The store must be shared
# by all servers; empty = CACHE_DRIVER.
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_STORE=

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_DATABASE=vtphp
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=database
CACHE_PREFIX=vtphp_cache

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=vtphp_session
# Empty = Secure automatically on HTTPS requests; true/false forces it.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# sync = run jobs right away; database = queue them for `php forge queue:work`.
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# ssl (implicit TLS, port 465), tls (require STARTTLS), or null (STARTTLS if offered)
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=app
